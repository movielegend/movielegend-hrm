<h2>V. MODULE 4: DASHBOARD DOANH SỐ THEO BỘ PHẬN</h2>
<p>Đồng bộ dữ liệu hằng ngày từ Google Sheets qua API Backend tới App Dashboard để thúc đẩy thi đua.</p>

<table class="spec-table">
  <thead>
    <tr>
      <th style="width: 20%;">Đối tượng Nhân sự</th>
      <th style="width: 30%;">Phạm vi Xem Dữ liệu Doanh số</th>
      <th style="width: 50%;">Quy tắc & Logic Đặc thù</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><b>Nhân viên thông thường</b></td>
      <td>Chỉ xem Bộ phận của mình</td>
      <td>Không được phép truy cập doanh số của các bộ phận khác.</td>
    </tr>
    <tr>
      <td><b>Livestream Hà Nội</b></td>
      <td>Xem Livestream HN + Livestream HCM</td>
      <td><b>Ngoại lệ đặc thù:</b> Mở cross-view giữa 2 chi nhánh HN & HCM để kích hoạt tính thi đua cạnh tranh.</td>
    </tr>
    <tr>
      <td><b>Livestream HCM</b></td>
      <td>Xem Livestream HCM + Livestream Hà Nội</td>
      <td><b>Ngoại lệ đặc thù:</b> Mở cross-view giữa 2 chi nhánh HCM & HN để kích hoạt tính thi đua cạnh tranh.</td>
    </tr>
    <tr>
      <td><b>Leader / Manager</b></td>
      <td>Bộ phận hiện tại + Các nhóm con</td>
      <td>Tự động gom dữ liệu theo cây Sơ đồ tổ chức (Department Tree). Xem báo cáo chi tiết theo nhân sự.</td>
    </tr>
    <tr>
      <td><b>Director / Executive (L8)</b></td>
      <td>Toàn công ty (Global)</td>
      <td>Xem tổng thể toàn hệ thống, so sánh tăng trưởng giữa các phòng ban, lọc theo mốc thời gian.</td>
    </tr>
  </tbody>
</table>

<hr>

<h2>VI. PHỤ LỤC KỸ THUẬT (DATABASE SCHEMA HỖ TRỢ THƯỞNG HIỆN VẬT)</h2>

<div class="code-block">
enum RewardType {
  CASH
  PHYSICAL_ITEM
  HYBRID // Cả tiền mặt lẫn hiện vật (Ví dụ: 15tr + MacBook)
}

model EmployeeLevel {
  id                    String      @id @default(uuid())
  levelNumber           Int         @unique // 1 -> 8
  code                  String      @unique // INTERN, OFFICIAL...
  name                  String      // Thực tập, Senior...
  colorCode             String      // Hex color: #2563EB
  badgeIcon             String?
  minSeniorityMonths    Int         @default(0)
  
  // Khung Thưởng Tiền Mặt & Hiện Vật
  rewardType            RewardType  @default(CASH)
  promotionBonusAmount  Decimal     @default(0) @db.Decimal(15, 2) // Thưởng tiền mặt
  physicalItemName      String?     // Tên hiện vật: "MacBook Air M3", "MacBook Pro M3 Max", "iPad"...
  physicalItemImageUrl  String?     // Link ảnh minh họa hiện vật hiển thị trên App Mobile
  
  kpiBonusMultiplier    Decimal     @default(1.0) @db.Decimal(3, 2)
  monthlyAllowance      Decimal     @default(0) @db.Decimal(15, 2)
  benefitDescription    String?

  autoAssignRoleIds     String[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  users                 User[]
}
</div>

</body>
</html>
