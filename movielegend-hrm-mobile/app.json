{
  "expo": {
    "name": "ML Group",
    "slug": "movielegend-hrm-mobile",
    "privacy": "public",
    "scheme": "movielegend-hrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinhhoc.movielegendhrmmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.dinhhoc.movielegendhrmmobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần quyền truy cập camera để chụp ảnh xác thực khuôn mặt khi nhân viên chấm công."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để bạn có thể tải lên biên bản, hoá đơn hoặc giấy tờ liên quan."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ứng dụng cần quyền truy cập vị trí để xác minh bạn đang đứng tại văn phòng công ty khi chấm công."
        }
      ],
      "expo-local-authentication",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/ringtone.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "pickFirsts": [
                "**/libjingle_peerconnection_so.so",
                "**/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-web-browser",
      "expo-document-picker",
      "./withWebRTCExclude.js",
      "@livekit/react-native-expo-plugin"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4a5152ea-87fd-4faf-829b-63e01ed4de9d"
      }
    },
    "runtimeVersion": "1.0.0"
  }
}