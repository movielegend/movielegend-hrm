    border-bottom: 2px solid #1E3A8A;
    padding-bottom: 8px;
    margin-top: 20px;
    margin-bottom: 20px;
  }
  h2 {
    font-size: 15pt;
    color: #1E40AF;
    border-left: 4px solid #3B82F6;
    padding-left: 10px;
    margin-top: 25px;
    margin-bottom: 12px;
  }
  h3 {
    font-size: 12pt;
    color: #1E3A8A;
    margin-top: 15px;
    margin-bottom: 8px;
  }
