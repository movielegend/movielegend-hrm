      <td>Check-in đúng giờ liên tục không trễ ca nào trong tháng</td>
      <td>Hàng tháng</td>
    </tr>
    <tr>
      <td><b>Đánh giá "Làm tốt" (EXCELLENT)</b></td>
      <td><b>+50 điểm</b></td>
      <td>Được Leader/Manager ghi nhận sự cố gắng / sáng kiến</td>
      <td>Theo từng vụ việc</td>
    </tr>
