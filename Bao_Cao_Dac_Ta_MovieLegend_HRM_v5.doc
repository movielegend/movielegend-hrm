      <td>Hoàn thành $100%$ chỉ tiêu công việc tháng</td>
      <td>Hàng tháng</td>
    </tr>
    <tr>
      <td><b>Vượt > 120% KPI Tháng</b></td>
      <td><b>+500 điểm</b></td>
      <td>Vượt chỉ tiêu tháng trên $120%$</td>
      <td>Hàng tháng</td>
    </tr>
    <tr>
      <td><b>Top 1 Doanh số Bộ phận</b></td>
      <td><b>+1.000 điểm</b></td>
      <td>Đạt vị trí số 1 Bảng xếp hạng Doanh số phòng tháng</td>
      <td>Hàng tháng</td>
    </tr>
    <tr>
      <td><b>Vi phạm / Cảnh cáo (WARNING)</b></td>
      <td><span style="color: red; font-weight: bold;">-200 điểm</span></td>
      <td>Bị lập biên bản cảnh cáo hoặc trễ công việc nghiêm trọng</td>
      <td>Theo vụ việc</td>
    </tr>
  </tbody>
</table>

